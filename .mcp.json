{
  "mcpServers": {
    "colab-mcp": {
      "command": "uv",
      "args": [
        "run", "--no-project", "--python", "3.13",
        "--with", "git+https://github.com/googlecolab/colab-mcp",
        "python", "scripts/colab_mcp_launcher.py"
      ],
      "timeout": 600000
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
